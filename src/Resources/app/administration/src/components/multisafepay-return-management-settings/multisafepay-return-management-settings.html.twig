{# Shopware's config-field renderer needs a concrete root element; an HTML <template> root renders an empty card. #}
<div class="multisafepay-return-management-settings">
    {# Show this settings body only when the plugin's PHP endpoint confirms Shopware Return Management is available. #}
    <div v-if="isAvailable">
        {# Merchant toggle: link eligible Shopware Return refund amounts to MultiSafepay refund processing. #}
        <sw-switch-field
            v-model:value="enabledValue"
            :name="name"
            :label="$tc('multisafepay-return-management.enable')"
            :help-text="$tc('multisafepay-return-management.enable_help')"
            :disabled="disabled"
            :error="error"
        ></sw-switch-field>
        {# Read-only target state returned by PHP; this is the Shopware Return state that triggers processing. #}
        <sw-text-field
            :value="targetStateValue"
            name="sw-field--multisafepay-return-management-target-state"
            :label="$tc('multisafepay-return-management.target_state')"
            :disabled="true"
        />
        <p class="multisafepay-return-management-settings__target-state-description">
            {{ $tc('multisafepay-return-management.target_state_description') }}
        </p>
    </div>
</div>

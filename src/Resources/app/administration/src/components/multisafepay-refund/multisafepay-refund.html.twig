{# Render the refund card only when the plugin's PHP endpoint allows refunds for this order. #}
<template v-if="isRefundAllowed">
    <mt-card
        :title="$t('multisafepay-refund.refund_title')"
        :isLoading="isLoading"
        class="sw-order-detail-base__line-item-grid-card"
        role="region"
        :aria-label="$t('multisafepay-refund.refund_options')">
        {# Manual refund controls: amount input, submit button, and refunded amount summary. #}
        <mt-number-field
            :label="$t('multisafepay-refund.amount')"
            name="sw-field--amount"
            :model-value="amount"
            :placeholder="amountPlaceholder"
            number-type="float"
            :step="0.01"
            :max="maxRefundableAmount"
            :disabled="isRefundDisabled"
            @update:model-value="onAmountChanged"
            aria-required="true">
        </mt-number-field>
        <div class="multisafepay-refund__actions">
            <mt-button
                variant="primary"
                @click="showRefundModal()"
                :disabled="isRefundDisabled"
                :aria-label="$t('multisafepay-refund.refund')">
                {{ $t('multisafepay-refund.refund') }}
            </mt-button>
            <div class="multisafepay-refund__amount-status">
                <strong>{{ $t('multisafepay-refund.amount_refunded') }}: {{ order ? order.currency.symbol : 'currency' }}&nbsp;{{ refundedAmountFormatted }}</strong>
            </div>
            {# Dismissible refund warning with amount breakdown and optional MultiSafepay response details. #}
            <div
                v-if="hasStructuredRefundError"
                class="multisafepay-refund__amount-message multisafepay-refund__amount-message--structured multisafepay-refund__amount-error">
                <button
                    type="button"
                    class="multisafepay-refund__amount-message-dismiss"
                    :disabled="isStructuredRefundErrorDismissDisabled"
                    :aria-label="$t('multisafepay-refund.dismiss_error_message')"
                    :title="$t('multisafepay-refund.dismiss_error_message')"
                    @click="dismissStructuredRefundError">
                    &times;
                </button>
                <p
                    v-if="structuredRefundError.intro"
                    class="multisafepay-refund__amount-message-paragraph">
                    {{ structuredRefundError.intro }}
                </p>
                <ul
                    v-if="returnManagementRefundErrorDetails.length"
                    class="multisafepay-refund__amount-message-list">
                    <li
                        v-for="detail in returnManagementRefundErrorDetails"
                        :key="detail.label"
                        class="multisafepay-refund__amount-message-item">
                        <strong class="multisafepay-refund__amount-message-label">{{ detail.label }}:</strong>
                        <span>{{ detail.value }}</span>
                    </li>
                </ul>
                <p
                    v-if="structuredRefundError.action"
                    class="multisafepay-refund__amount-message-paragraph">
                    {{ structuredRefundError.action }}
                </p>
                <p
                    v-if="returnManagementRefundErrorResponse"
                    class="multisafepay-refund__amount-message-paragraph">
                    <strong class="multisafepay-refund__amount-message-label">{{ returnManagementRefundErrorResponse.label }}:</strong>
                    <span>{{ returnManagementRefundErrorResponse.message }}</span>
                    <span v-if="returnManagementRefundErrorResponse.code">({{ returnManagementRefundErrorResponseCodeLabel }}: {{ returnManagementRefundErrorResponse.code }})</span>
                </p>
            </div>
            {# Fallback status message for refund states that do not need the structured Return warning. #}
            <div
                v-else-if="refundAmountStatusMessage"
                class="multisafepay-refund__amount-message multisafepay-refund__amount-error">
                {{ refundAmountStatusMessage }}
            </div>
        </div>
        {# Confirms the manual refund amount before sending the refund request. #}
        <sw-modal
            v-show="showModal"
            :title="$t('multisafepay-refund.confirm_refund_title')"
            variant="small"
            @modal-close="closeModal()"
            role="dialog"
            aria-live="polite"
            :aria-label="$t('multisafepay-refund.confirm_refund')">
            <template #default>
                {{ confirmRefundMessage }}
                <br/>
            </template>
            <template #modal-footer>
                <mt-button
                    @click="closeModal()"
                    size="small"
                    :aria-label="$t('multisafepay-refund.cancel_refund')">
                    {{ $t('global.default.cancel') }}
                </mt-button>
                <mt-button @click="confirmRefund()"
                    size="small"
                    variant="primary"
                    :aria-label="$t('multisafepay-refund.confirm_process_refund')">
                    {{ $t('multisafepay-refund.confirm') }}
                </mt-button>
            </template>
        </sw-modal>
        {# Confirms dismissal of the structured Shopware Return warning. #}
        <sw-modal
            v-if="showReturnManagementRefundErrorDismissModal"
            :title="$t('multisafepay-refund.confirm_dismiss_error_title')"
            variant="small"
            @modal-close="closeReturnManagementRefundErrorDismissModal()"
            role="dialog"
            aria-live="polite"
            :aria-label="$t('multisafepay-refund.confirm_dismiss_error_title')">
            <template #default>
                {{ $t('multisafepay-refund.confirm_dismiss_error_message') }}
            </template>
            <template #modal-footer>
                <mt-button
                    @click="closeReturnManagementRefundErrorDismissModal()"
                    size="small"
                    :disabled="isDismissingReturnManagementRefundError">
                    {{ $t('multisafepay-refund.cancel_dismiss_error') }}
                </mt-button>
                <mt-button
                    @click="dismissReturnManagementRefundError()"
                    size="small"
                    variant="primary"
                    :disabled="isDismissingReturnManagementRefundError"
                    :aria-label="$t('multisafepay-refund.confirm_dismiss_error')">
                    {{ $t('multisafepay-refund.confirm_dismiss_error') }}
                </mt-button>
            </template>
        </sw-modal>
    </mt-card>
</template>
